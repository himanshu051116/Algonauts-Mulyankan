# Database (Docker Compose defaults)
DATABASE_URL=postgresql+asyncpg://replace-with-local-postgres-user:replace-with-local-postgres-password@localhost:5432/mulyankan

# Supabase (for auth integration)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHMS=RS256,ES256
SUPABASE_JWKS_CACHE_SECONDS=300
JWT_CLOCK_SKEW_SECONDS=60

# JWT (used for local auth fallback)
AUTH_ALLOW_LOCAL_JWT=false
LOCAL_JWT_ISSUER=mulyankan-local-dev
LOCAL_JWT_AUDIENCE=mulyankan-dev
JWT_SECRET=replace-with-local-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# Storage (MinIO — Docker Compose defaults)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PUBLIC_ENDPOINT=http://127.0.0.1:9000
STORAGE_ACCESS_KEY=replace-with-local-minio-user
STORAGE_SECRET_KEY=replace-with-local-minio-password
STORAGE_BUCKET=mulyankan-proposals
STORAGE_REGION=us-east-1

# Redis (Docker Compose defaults)
REDIS_URL=redis://127.0.0.1:6379/0

# OCR
OCR_LANGUAGE=eng+hin

# Security
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=.pdf,.docx,.txt
MALWARE_SCAN_ENABLED=false

# Rate limiting
RATE_LIMIT_PER_MINUTE=30

# Logging
LOG_LEVEL=INFO
SENTRY_DSN=

# Monitoring
OTEL_SERVICE_NAME=mulyankan-backend
