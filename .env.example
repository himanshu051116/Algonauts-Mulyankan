# Mulyankan local/deployment environment template.
# Copy to .env, replace every placeholder, and never commit the resulting file.

# ---------- Frontend / Supabase public configuration ----------
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
VITE_PUBLIC_APP_URL=http://localhost:3000
# Add both <app-url>/auth/callback and <app-url>/auth/reset-password to
# Supabase Auth redirect URLs.
# For Vercel, point this to the deployed FastAPI backend, for example:
# VITE_API_URL=https://api.example.gov.in

# ---------- Backend Supabase JWT verification ----------
SUPABASE_URL=https://your-project.supabase.co
# Normally leave these blank so they are derived from SUPABASE_URL.
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHMS=RS256,ES256
SUPABASE_JWKS_CACHE_SECONDS=300
JWT_CLOCK_SKEW_SECONDS=60
# Never expose the service-role key to the frontend. It is optional for the current API.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- PostgreSQL ----------
POSTGRES_USER=mulyankan_dev
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=mulyankan
# Used outside Docker. Docker Compose builds DATABASE_URL from the three values above.
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/mulyankan

# ---------- Private object storage ----------
MINIO_ROOT_USER=mulyankan_storage
MINIO_ROOT_PASSWORD=replace-with-a-long-random-storage-password
STORAGE_BUCKET=mulyankan-proposals
STORAGE_PUBLIC_ENDPOINT=http://127.0.0.1:9000
# For a managed S3-compatible provider, set STORAGE_ENDPOINT/ACCESS_KEY/SECRET_KEY directly.
# STORAGE_ENDPOINT=https://s3.example.gov.in
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_REGION=us-east-1

# ---------- Authentication ----------
# Local JWT is development-only. It must be false in production.
AUTH_ALLOW_LOCAL_JWT=true
LOCAL_JWT_ISSUER=mulyankan-local-dev
LOCAL_JWT_AUDIENCE=mulyankan-dev
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ---------- Runtime safety ----------
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:4174,http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1
TRUST_PROXY_HEADERS=true
RATE_LIMIT_PER_MINUTE=60
READINESS_TIMEOUT_SECONDS=3
SIGNED_DOWNLOAD_TTL_SECONDS=900
METRICS_ENABLED=true
# Required when ENVIRONMENT=production and metrics are enabled.
METRICS_TOKEN=replace-with-a-random-monitoring-token
# Required in production for controlled HMAC-signed audit exports.
AUDIT_EXPORT_SIGNING_KEY=replace-with-at-least-32-random-characters

# ---------- Document processing ----------
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=.pdf,.docx,.txt
OCR_LANGUAGE=eng+hin
# Production startup requires this to be true and readiness verifies the scanner binary.
MALWARE_SCAN_ENABLED=false
MALWARE_SCAN_COMMAND=clamscan
MALWARE_SCAN_TIMEOUT_SECONDS=60

# ---------- Worker ----------
REDIS_URL=redis://localhost:6379/0
WORKER_HEARTBEAT_KEY=mulyankan:worker:heartbeat
WORKER_HEARTBEAT_TTL_SECONDS=120

# ---------- Initial administrator ----------
BOOTSTRAP_ADMIN_UID=your-supabase-user-id
BOOTSTRAP_ADMIN_EMAIL=admin@example.gov.in

# ---------- Optional observability ----------
LOG_LEVEL=INFO
SENTRY_DSN=
OTEL_SERVICE_NAME=mulyankan-backend

# ---------- Optional Docker host-port overrides ----------
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=8000

# Keeps this release isolated from older Mulyankan Compose stacks.
COMPOSE_PROJECT_NAME=mulyankan-080
